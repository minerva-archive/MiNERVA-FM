# Copy to .env and fill in real values before deploying.
# .env is git-ignored — never commit secrets.

# Auth token for metadata updates and admin endpoints (change this!)
BRIDGE_TOKEN=changeme

# Audio stream bitrate (AAC). 128k is a good balance for FLAC sources.
STREAM_BITRATE=128k

# Port exposed on the host (nginx inside the container always listens on 8080)
HTTP_PORT=8080

# Per-track time limits (seconds)
# SID_DURATION=180
# MAX_TRACK=300
